---
// Top of page ("Top B"). Sizes here are Harrison's exact design values, so they are
// plain px rather than the scaled --space-* steps.
import { hero, meta } from '../lib/content';
import { inline } from '../lib/inline';
import Photo from './Photo.astro';
import SharePeople from './SharePeople.astro';
---

<section class="hero column" aria-labelledby="headline">
  <Photo
    class="hero__portrait"
    image={{ file: 'portrait-shed.jpg' }}
    alt={meta.shareImageAlt}
    eager
  />
  <h1 id="headline" class="hero__headline">{hero.headline}</h1>
  <div class="hero__copy">
    {hero.about.map((p) => <p class="hero__text" set:html={inline(p)} />)}

    <div class="hero__group">
      <p class="hero__text" set:html={inline(hero.strengths.leadIn)} />
      <ul class="hero__list bullets bullets--emoji" role="list">
        {
          hero.strengths.items.map((item) => (
            <li>
              <span class="bullets__marker" aria-hidden="true">{item.emoji}</span>
              <span set:html={inline(item.text)} />
            </li>
          ))
        }
      </ul>
    </div>

    <div class="hero__group">
      <p class="hero__text" set:html={inline(hero.roles.leadIn)} />
      <ul class="hero__list bullets bullets--star" role="list">
        {
          hero.roles.items.map((item) => (
            <li>
              <span set:html={inline(item)} />
            </li>
          ))
        }
      </ul>
    </div>

    <p class="hero__text" set:html={inline(hero.location)} />
  </div>

  <div class="hero__share-with">
    <div class="hero__share-inner">
      <p class="subheading">{hero.shareWith.leadIn}</p>
      <SharePeople people={hero.shareWith.people} size={28} />
    </div>
  </div>

  <p class="hero__closing">{hero.closingLine}</p>
</section>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    gap: 18px;
    padding-top: 18px;
  }

  .hero :global(.hero__portrait) {
    width: 100%;
    height: 200px;
    object-fit: cover;
    object-position: 50% 28%;
    border: var(--line);
    border-radius: var(--radius-card);
  }

  .hero__headline {
    margin: 0;
    font-size: var(--size-card-title);
    font-weight: 800;
    font-stretch: 62%;
    line-height: 0.92;
  }

  .hero__text {
    margin: 0;
    font-size: var(--size-body);
    line-height: 1.55;
  }

  .hero__text :global(strong) {
    font-weight: 800;
  }

  /* The paragraphs and lists, spaced out so they're easy to scan on a phone. */
  .hero__copy {
    display: flex;
    flex-direction: column;
    gap: 22px;
  }

  .hero__group {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .hero__list {
    display: grid;
    gap: 8px;
    font-size: var(--size-body);
    line-height: 1.55;
  }

  /* A box drawn with wavy lines on all 4 sides. */
  .hero__share-with {
    padding: 5px;
    background:
      url('../../assets/svg/rule-wavy.svg') top / 100% 10px no-repeat,
      url('../../assets/svg/rule-wavy.svg') bottom / 100% 10px no-repeat,
      url('../../assets/svg/wave-v.svg') left / 10px 100% no-repeat,
      url('../../assets/svg/wave-v.svg') right / 10px 100% no-repeat;
  }

  .hero__share-inner {
    display: flex;
    flex-direction: column;
    gap: 18px;
    padding: 18px 16px 20px;
  }

  .hero__closing {
    margin: 0;
    font-size: var(--size-body);
    line-height: 1.55;
  }
</style>
