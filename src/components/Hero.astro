---
// Top of page ("Top B"). Sizes here are Harrison's exact design values, so they are
// plain px rather than the scaled --space-* steps.
import { hero, meta } from '../lib/content';
import { inline } from '../lib/inline';
import ActionButtons from './ActionButtons.astro';
import Photo from './Photo.astro';

// Words marked ==like this== in the headline get a hand-drawn scribble underline.
// Splitting on the marks leaves the marked words at the odd positions.
const headlineParts = hero.headline.split(/==(.+?)==/);
---

<section class="hero column" aria-labelledby="headline">
  <Photo
    class="hero__portrait"
    image={{ file: 'portrait-shed.jpg' }}
    alt={meta.shareImageAlt}
    eager
  />
  <h1 id="headline" class="hero__headline">
    {
      headlineParts.map((part, i) =>
        i % 2 === 0 ? (
          part
        ) : (
          <span class="scribble">
            {part}
            <svg viewBox="0 0 300 20" preserveAspectRatio="none" aria-hidden="true">
              <path
                d="M4 5 C100 2 200 3 294 5 C302 8 70 8 14 11 C-2 14 220 13 292 15 C298 17 160 18 90 19"
                fill="none"
                stroke="#111"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                vector-effect="non-scaling-stroke"></path>
            </svg>
          </span>
        ),
      )
    }
  </h1>
  <p class="hero__subtitle" set:html={inline(hero.subtitle)} />

  <div class="hero__share-with">
    <div class="hero__share-inner">
      <p class="hero__lead-in">{hero.shareWith.leadIn}</p>
      <ul class="hero__people">
        {hero.shareWith.people.map((person) => <li>{person}</li>)}
      </ul>
    </div>
  </div>

  <p class="hero__closing">{hero.closingLine}</p>

  <ActionButtons />
</section>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    gap: 18px;
    padding-top: 18px;
  }

  .hero :global(.hero__portrait) {
    width: 100%;
    height: 200px;
    object-fit: cover;
    object-position: 50% 28%;
    border: var(--line);
    border-radius: var(--radius-card);
  }

  .hero__headline {
    margin: 0;
    font-size: 40px;
    font-weight: 800;
    font-stretch: 62%;
    line-height: 0.92;
  }

  /* The scribble reaches 32px below the words (14px gap + 18px tall), so the headline
     makes room for it, keeping the usual 18px before the subtitle. */
  .hero__headline:has(.scribble) {
    padding-bottom: 34px;
  }

  .scribble {
    position: relative;
    white-space: nowrap;
  }

  .scribble svg {
    position: absolute;
    top: calc(100% + 14px);
    left: -3px;
    width: calc(100% + 6px);
    /* The site caps images at their container's width; this one is meant to stick out 3px each side. */
    max-width: none;
    height: 18px;
    overflow: visible;
  }

  .hero__subtitle {
    margin: 0;
    font-size: 17px;
    font-weight: 500;
    line-height: 1.45;
  }

  .hero__subtitle :global(strong) {
    font-weight: 800;
  }

  /* A box drawn with wavy lines on all 4 sides. */
  .hero__share-with {
    padding: 5px;
    background:
      url('../../assets/svg/rule-wavy.svg') top / 100% 10px no-repeat,
      url('../../assets/svg/rule-wavy.svg') bottom / 100% 10px no-repeat,
      url('../../assets/svg/wave-v.svg') left / 10px 100% no-repeat,
      url('../../assets/svg/wave-v.svg') right / 10px 100% no-repeat;
  }

  .hero__share-inner {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 18px 18px 20px;
  }

  .hero__lead-in {
    margin: 0;
    font-size: 22px;
    font-weight: 800;
    font-stretch: 62%;
    line-height: 1;
  }

  .hero__people {
    display: grid;
    gap: 8px;
    margin: 0;
    padding-left: 1.2em;
    font-size: 16px;
    line-height: 1.4;
  }

  .hero__closing {
    margin: 0;
    font-size: 16px;
    line-height: 1.5;
  }
</style>
