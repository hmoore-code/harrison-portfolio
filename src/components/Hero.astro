---
// Top of page ("Top B"). Sizes here are Harrison's exact design values, so they are
// plain px rather than the scaled --space-* steps.
import { hero, meta } from '../lib/content';
import { inline } from '../lib/inline';
import Photo from './Photo.astro';
import SharePeople from './SharePeople.astro';
---

<section class="hero column" aria-labelledby="headline">
  <Photo
    class="hero__portrait"
    image={{ file: 'portrait-shed.jpg' }}
    alt={meta.shareImageAlt}
    eager
  />
  <h1 id="headline" class="hero__headline">{hero.headline}</h1>
  <p class="hero__text" set:html={inline(hero.mission)} />
  <div class="hero__strengths">
    <p class="hero__text" set:html={inline(hero.strengths.leadIn)} />
    <ul class="hero__strengths-list" role="list">
      {hero.strengths.items.map((item) => <li set:html={inline(item)} />)}
    </ul>
  </div>
  <p class="hero__text" set:html={inline(hero.values)} />
  <p class="hero__text" set:html={inline(hero.availability)} />

  <div class="hero__share-with">
    <div class="hero__share-inner">
      <p class="subheading">{hero.shareWith.leadIn}</p>
      <SharePeople people={hero.shareWith.people} size={28} />
    </div>
  </div>

  <p class="hero__closing">{hero.closingLine}</p>
</section>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    gap: 18px;
    padding-top: 18px;
  }

  .hero :global(.hero__portrait) {
    width: 100%;
    height: 200px;
    object-fit: cover;
    object-position: 50% 28%;
    border: var(--line);
    border-radius: var(--radius-card);
  }

  .hero__headline {
    margin: 0;
    font-size: var(--size-card-title);
    font-weight: 800;
    font-stretch: 62%;
    line-height: 0.92;
  }

  .hero__text {
    margin: 0;
    font-size: var(--size-body);
    line-height: 1.55;
  }

  .hero__text :global(strong) {
    font-weight: 800;
  }

  .hero__strengths {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  /* role="list" keeps it a list for VoiceOver, which drops list-style: none lists. */
  .hero__strengths-list {
    display: grid;
    gap: var(--space-1);
    margin: 0;
    padding: 0;
    font-size: var(--size-body);
    font-weight: 800;
    line-height: 1.55;
    list-style: none;
  }

  /* The star as the bullet, as in the pop-ups' skills box: 12px, centred on the line, 10px before the text. */
  .hero__strengths-list li {
    display: grid;
    grid-template-columns: 12px 1fr;
    column-gap: 10px;
  }

  .hero__strengths-list li::before {
    content: '';
    width: 12px;
    height: 12px;
    margin-top: calc((1.55em - 12px) / 2);
    background: url('../../assets/svg/star.svg') center / contain no-repeat;
  }

  /* A box drawn with wavy lines on all 4 sides. */
  .hero__share-with {
    padding: 5px;
    background:
      url('../../assets/svg/rule-wavy.svg') top / 100% 10px no-repeat,
      url('../../assets/svg/rule-wavy.svg') bottom / 100% 10px no-repeat,
      url('../../assets/svg/wave-v.svg') left / 10px 100% no-repeat,
      url('../../assets/svg/wave-v.svg') right / 10px 100% no-repeat;
  }

  .hero__share-inner {
    display: flex;
    flex-direction: column;
    gap: 18px;
    padding: 18px 16px 20px;
  }

  .hero__closing {
    margin: 0;
    font-size: var(--size-body);
    line-height: 1.55;
  }
</style>
