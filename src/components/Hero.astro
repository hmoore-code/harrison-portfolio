---
import { hero, meta } from '../lib/content';
import Photo from './Photo.astro';
import WavyRule from './WavyRule.astro';
---

<section class="hero column" aria-labelledby="headline">
  <Photo
    class="hero__portrait"
    image={{ file: 'portrait-shed.jpg' }}
    alt={meta.shareImageAlt}
    eager
  />
  <h1 id="headline" class="hero__headline">{hero.headline}</h1>
  <ul class="hero__roles">
    {
      hero.roles.map((role) => (
        <li>
          <WavyRule />
          <span class="hero__role">{role}</span>
        </li>
      ))
    }
    <li aria-hidden="true"><WavyRule /></li>
  </ul>
  <p class="hero__pitch">{hero.pitch}</p>
  <div class="hero__actions">
    <a class="pill pill--solid" href={`mailto:${hero.email}`}>{hero.contactButton}</a>
    <a class="pill pill--outline" href="#cv" data-open-dialog="cv">{hero.cvButton}</a>
  </div>
  <a class="hero__help" href="#help">{hero.purposeLine}</a>
</section>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding-top: var(--space-3);
  }

  .hero :global(.hero__portrait) {
    width: 100%;
    height: 200px;
    object-fit: cover;
    object-position: 50% 28%;
    border: var(--line);
    border-radius: var(--radius-card);
  }

  .hero__headline {
    margin: 0;
    font-size: var(--size-headline);
    font-weight: 800;
    font-stretch: 62%;
    line-height: 0.88;
  }

  .hero__roles {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .hero__role {
    display: block;
    padding: var(--space-2) 0;
    font-size: 19px;
    font-weight: 700;
    font-stretch: 85%;
    line-height: 1.3;
  }

  .hero__pitch {
    margin: 0;
    font-size: 17px;
    font-weight: 500;
    line-height: 1.45;
  }

  .hero__actions {
    display: flex;
    gap: 10px;
  }

  .hero__actions .pill {
    flex: 1;
    padding: 0 var(--space-3);
  }

  .hero__help {
    align-self: center;
    display: flex;
    align-items: center;
    min-height: 44px;
    font-size: 15px;
    font-weight: 600;
    text-align: center;
  }
</style>
