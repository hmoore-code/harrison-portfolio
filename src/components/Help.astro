---
import { help, meta } from '../lib/content';
import WavyRule from './WavyRule.astro';
---

<section class="help column" id="help" aria-labelledby="help-heading">
  <h2 id="help-heading" class="section-heading">{help.heading}</h2>

  {
    help.lists.map((list) => (
      <div class="help__group">
        <h3 class="subheading">{list.heading}</h3>
        <ul class="help__list">
          {list.items.map((item) => (
            <li>
              <WavyRule />
              <span class="help__item">{item}</span>
            </li>
          ))}
          <li aria-hidden="true">
            <WavyRule />
          </li>
        </ul>
      </div>
    ))
  }

  <div class="help__share">
    <p>{help.share.leadIn}</p>
    <button
      class="pill pill--solid"
      type="button"
      data-share
      data-share-title={meta.pageTitle}
      data-share-confirmation={help.share.confirmation}
    >
      <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">
        <path
          d="M8 1.5v9 M4.5 5L8 1.5L11.5 5 M3.5 8v6.5h9V8"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
      {help.share.button}
    </button>
  </div>
</section>

<style>
  .help {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .help__group {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .help__list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .help__item {
    display: block;
    padding: var(--space-2) 0;
    font-size: 19px;
    font-weight: 700;
    font-stretch: 85%;
    line-height: 1.3;
  }

  .help__share {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-4);
    border: var(--line);
    border-radius: var(--radius-card);
    background: var(--white);
  }

  .help__share p {
    margin: 0;
    font-size: 19px;
    font-weight: 500;
    line-height: 1.4;
  }
</style>
