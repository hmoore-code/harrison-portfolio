---
import { contact, isTodo, projectsIntro } from '../lib/content';
import { inline } from '../lib/inline';
import Icon from './Icon.astro';
import Todo from './Todo.astro';

const heading = isTodo(contact.heading) ? null : contact.heading;
// Small brand marks drawn on a 20px grid, shown inside 2px ink circles.
const links = [
  {
    label: 'LinkedIn',
    value: contact.linkedin,
    mark: 'M3.5 8h3v9h-3z M5 2.75a1.75 1.75 0 1 1 0 3.5a1.75 1.75 0 0 1 0-3.5z M8.5 8h2.9v1.3c.5-.9 1.6-1.6 3.1-1.6c2.6 0 3.5 1.6 3.5 4.2V17h-3v-4.6c0-1.2-.3-2-1.4-2c-1.2 0-1.6.9-1.6 2.1V17h-3z',
  },
  {
    label: 'Substack',
    value: contact.substack,
    mark: 'M4 3h12v2H4z M4 6.5h12v2H4z M4 10h12v8l-6-3.4L4 18z',
  },
];
---

<section class="contact column" id="contact" aria-labelledby="contact-heading">
  {
    heading ? (
      <h2 id="contact-heading" class="section-heading">
        {heading}
      </h2>
    ) : (
      <h2 id="contact-heading">
        <Todo text={isTodo(contact.heading) ? contact.heading.todo : ''} />
      </h2>
    )
  }
  {
    contact.line &&
      (isTodo(contact.line) ? <Todo text={contact.line.todo} block /> : <p class="contact__line" set:html={inline(contact.line)} />)
  }
  <a class="pill pill--solid contact__email" href={`mailto:${contact.email}`}>
    <Icon name="mail" />
    {contact.emailButton}
  </a>
  <ul class="contact__socials">
    {
      links.map((link) => (
        <li>
          {isTodo(link.value) ? (
            <Todo text={`${link.label}: ${link.value.todo}`} />
          ) : (
            <a class="contact__social" href={link.value} target="_blank" rel="noopener">
              <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true">
                <path d={link.mark} fill="currentColor" />
              </svg>
              <span class="visually-hidden">{link.label} ({projectsIntro.newTabHint})</span>
            </a>
          )}
        </li>
      ))
    }
  </ul>
</section>


<style>
  .contact {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding-bottom: var(--space-7);
  }

  .contact__line {
    margin: 0;
    font-size: 19px;
    font-weight: 500;
    line-height: 1.4;
  }

  .contact__socials {
    display: flex;
    justify-content: center;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .contact__social {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border: var(--line);
    border-radius: 50%;
    color: var(--ink);
  }
</style>
