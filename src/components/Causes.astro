---
import { causes } from '../lib/content';
import ActionButtons from './ActionButtons.astro';
import WavyRule from './WavyRule.astro';
---

<section class="causes column" id="causes" aria-labelledby="causes-heading">
  <h2 id="causes-heading" class="section-heading">{causes.heading}</h2>
  <p class="causes__intro">{causes.intro}</p>
  <ol class="causes__list">
    {
      causes.items.map((cause, i) => (
        <li>
          <WavyRule />
          <p class="causes__item">
            <span class="causes__number" aria-hidden="true">
              {i + 1}
            </span>
            {cause}
          </p>
        </li>
      ))
    }
    <li aria-hidden="true"><WavyRule /></li>
  </ol>
  <p class="causes__ask">{causes.closingAsk}</p>
  {
    causes.people && (
      <div class="causes__people">
        <h3 class="subheading">{causes.people.heading}</h3>
        <ul class="causes__people-list">
          {causes.people.items.map((person) => (
            <li>
              <WavyRule />
              <span class="causes__person">{person}</span>
            </li>
          ))}
          <li aria-hidden="true">
            <WavyRule />
          </li>
        </ul>
      </div>
    )
  }
  <ActionButtons class="causes__actions" />
</section>

<style>
  .causes {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .causes__intro,
  .causes__ask {
    margin: 0;
    font-size: 19px;
    font-weight: 500;
    line-height: 1.4;
  }

  .causes__list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .causes__item {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    margin: 0;
    padding: var(--space-3) 0;
    font-size: var(--size-subheading);
    font-weight: 800;
    font-stretch: 62%;
    line-height: 1.05;
  }

  .causes__people {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-top: var(--space-3);
  }

  .causes__people-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .causes__person {
    display: block;
    padding: var(--space-2) 0;
    font-size: 19px;
    font-weight: 700;
    font-stretch: 85%;
    line-height: 1.3;
  }

  .causes :global(.causes__actions) {
    margin-top: var(--space-3);
  }

  .causes__number {
    flex: none;
    min-width: 1ch;
    font-size: 15px;
    font-weight: 700;
    font-stretch: 100%;
  }
</style>
