---
import { projectsIntro, type Project } from '../lib/content';
import CoveredImage from './CoveredImage.astro';
import iconLearn from '../../assets/svg/icon-learn.svg?url';
import iconTalk from '../../assets/svg/icon-talk.svg?url';
import iconExperience from '../../assets/svg/icon-experience-logo-star.svg?url';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const headingId = `card-${project.slug}`;
// One icon per filter, shown before the filter label on the card (not on the filter buttons).
// Width and height are each file's own proportions, so the space is held before it loads.
const icons: Record<string, { src: string; width: number; height: number }> = {
  learning: { src: iconLearn, width: 630, height: 630 },
  tools: { src: iconTalk, width: 700, height: 590 },
  experiences: { src: iconExperience, width: 820, height: 490 },
};
const icon = icons[project.filter.id];
---

<article class="card" data-filter={project.filter.id} aria-labelledby={headingId}>
  <CoveredImage class="card__image" image={project.image} alt={project.imageAlt} cover={project.filter.cover} />
  <div class="card__body">
    <p class="label card__label">
      <img class="card__icon" src={icon.src} width={icon.width} height={icon.height} alt="" />
      {project.filter.label}
    </p>
    <h3 id={headingId} class="card__title">{project.title}</h3>
    <p class="card__result">{project.result}</p>
    <div class="card__actions">
      <a class="pill pill--solid pill--small" href={`#${project.slug}`} data-open-dialog={project.slug}>
        {projectsIntro.cardButton}<span class="visually-hidden">: {project.title}</span>
      </a>
    </div>
  </div>
</article>

<style>
  .card {
    overflow: hidden;
    border: var(--line);
    border-radius: var(--radius-card);
    background: var(--white);
  }

  .card[hidden] {
    display: none;
  }

  .card :global(.card__image) {
    height: 220px;
    border-bottom: var(--line);
  }

  .card__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-4) var(--space-4) calc(20px * var(--spacing-scale));
  }

  .card__label {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  /* 20px tall, width follows each icon's own shape. */
  .card__icon {
    flex: none;
    width: auto;
    height: 20px;
  }

  .card__title {
    width: 100%;
    margin: 0;
    font-size: var(--size-card-title);
    font-weight: 800;
    font-stretch: 62%;
    line-height: 0.92;
  }

  .card__result {
    margin: 0;
    font-size: 17px;
    line-height: 1.45;
  }

  .card__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
  }

</style>
