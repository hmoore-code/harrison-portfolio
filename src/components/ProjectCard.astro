---
import { projectsIntro, type Project } from '../lib/content';
import CoveredImage from './CoveredImage.astro';
import FilterIcon from './FilterIcon.astro';

interface Props {
  project: Project;
  // Position in the list, used to start each card's diamond glint at a different moment.
  index: number;
}

const { project, index } = Astro.props;
const headingId = `card-${project.slug}`;
---

<article class="card" data-filter={project.filter.id} aria-labelledby={headingId}>
  <CoveredImage class="card__image" image={project.image} alt={project.imageAlt} cover={project.filter.cover} />
  <div class="card__body">
    <p class="label card__label">
      <FilterIcon filterId={project.filter.id} />
      {project.filter.label}
    </p>
    <h3 class="card__title">
      <a class="card__title-link" href={`#${project.slug}`} data-open-dialog={project.slug}>
        <span id={headingId}>{project.title}</span><span class="visually-hidden">, {projectsIntro.cardTitleHint}</span>
      </a>
    </h3>
    <p class="card__result">{project.result}</p>
    <p class="card__skills">
      <span class="gem" style={`--gem-delay: ${(index * 0.7).toFixed(1)}s`} aria-hidden="true">
        <span class="gem__emoji">💎</span>
      </span>
      {project.skills}
    </p>
    <div class="card__actions">
      <a class="pill pill--solid pill--small" href={`#${project.slug}`} data-open-dialog={project.slug}>
        {project.cardButton}<span class="visually-hidden">: {project.title}</span>
      </a>
    </div>
  </div>
</article>

<style>
  .card {
    overflow: hidden;
    border: var(--line);
    border-radius: var(--radius-card);
    background: var(--white);
  }

  .card[hidden] {
    display: none;
  }

  .card :global(.card__image) {
    height: 220px;
    border-bottom: var(--line);
  }

  .card__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-4) var(--space-4) calc(20px * var(--spacing-scale));
  }

  .card__label {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .card__title {
    width: 100%;
    margin: 0;
    font-size: var(--size-card-title);
    font-weight: 800;
    font-stretch: 62%;
    line-height: 0.92;
  }

  /* The title opens the pop-up like the button, but keeps its look: underline on hover only. */
  .card__title-link {
    color: inherit;
    text-decoration: none;
  }

  @media (hover: hover) {
    .card__title-link:hover {
      text-decoration: underline;
    }
  }

  .card__result {
    margin: 0;
    font-size: 17px;
    line-height: 1.45;
  }

  .card__skills {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    margin: 0;
    font-size: 14px;
    font-weight: 600;
    line-height: 1.4;
  }

  /* The diamond glints every 4 seconds: a diagonal shine sweeps across it, it grows a touch,
     and a small sparkle appears and fades. The glint takes the first 0.6s (15%) of each cycle. */
  .gem {
    position: relative;
    flex: none;
    display: inline-block;
    animation: gem-pop 4s ease-out var(--gem-delay, 0s) infinite;
  }

  .gem__emoji {
    position: relative;
    display: block;
    overflow: hidden;
  }

  .gem__emoji::before {
    content: '';
    position: absolute;
    inset: -20% auto -20% -60%;
    z-index: 1;
    width: 50%;
    background: linear-gradient(90deg, transparent, rgb(255 255 255 / 95%) 50%, transparent);
    transform: translateX(0) skewX(-20deg);
    animation: gem-shine 4s ease-in-out var(--gem-delay, 0s) infinite;
  }

  .gem::after {
    content: '';
    position: absolute;
    top: -3px;
    right: -4px;
    width: 7px;
    height: 7px;
    background: var(--ink);
    clip-path: polygon(50% 0, 62% 38%, 100% 50%, 62% 62%, 50% 100%, 38% 62%, 0 50%, 38% 38%);
    opacity: 0;
    transform: scale(0);
    animation: gem-sparkle 4s ease-out var(--gem-delay, 0s) infinite;
  }

  @keyframes gem-pop {
    0%,
    15%,
    100% {
      transform: scale(1);
    }
    6% {
      transform: scale(1.12);
    }
  }

  @keyframes gem-shine {
    0% {
      transform: translateX(0) skewX(-20deg);
    }
    12%,
    100% {
      transform: translateX(400%) skewX(-20deg);
    }
  }

  @keyframes gem-sparkle {
    0%,
    3% {
      opacity: 0;
      transform: scale(0) rotate(0deg);
    }
    8% {
      opacity: 1;
      transform: scale(1) rotate(45deg);
    }
    15%,
    100% {
      opacity: 0;
      transform: scale(0.4) rotate(90deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .gem,
    .gem__emoji::before,
    .gem::after {
      animation: none;
    }

    .gem__emoji::before {
      display: none;
    }
  }

  .card__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
  }

</style>
