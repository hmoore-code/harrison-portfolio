---
// "More details about this project" for the writer's prompt library (design/14-prompts-popup.html):
// each line in copy.md ("View all writing prompts: https://...") is a black pill that opens in a new tab.
import { projectsIntro, type Project } from '../../lib/content';
import Icon from '../Icon.astro';

interface Props {
  project: Project;
}
const { project } = Astro.props;

const links = project.moreDetails.bullets.map((b) => {
  if (!b.label || !/^https?:\/\//.test(b.value ?? ''))
    throw new Error(`copy.md: "${project.name}", "More details about this project" line "${b.raw}" should be "Link text: https://..."`);
  return { text: b.label, href: b.value! };
});
if (!links.length) throw new Error(`copy.md: "${project.name}", "More details about this project" has no links`);
---

{
  links.map((link) => (
    <a class="pill pill--solid prompts__link" href={link.href} target="_blank" rel="noopener">
      {link.text}
      <Icon name="external" />
      <span class="visually-hidden"> ({projectsIntro.newTabHint})</span>
    </a>
  ))
}

<style>
  .prompts__link {
    min-height: 52px;
    font-size: 17px;
    font-weight: 700;
  }
</style>
