---
// "More details about this project" for the crowdfunded solo show (design/17-crowdfunding-popup.html):
// each line in copy.md ("Read the exhibition press release: sheffield-press-release.pdf") is a black
// pill that opens the PDF or web page in a new tab.
import { projectsIntro, type Project } from '../../lib/content';
import { findPdf } from '../../lib/assets';
import Icon from '../Icon.astro';

interface Props {
  project: Project;
}
const { project } = Astro.props;

const links = project.moreDetails.bullets.map((b) => {
  const value = b.value ?? '';
  const href = /^https?:\/\//.test(value) ? value : findPdf({ file: value });
  if (!b.label || !href)
    throw new Error(`copy.md: "${project.name}", "More details about this project" line "${b.raw}" should be "Button text: file.pdf" (in assets/pdfs) or "Button text: https://..."`);
  return { text: b.label, href };
});
if (!links.length) throw new Error(`copy.md: "${project.name}", "More details about this project" has no links`);
---

{
  links.map((link) => (
    <a class="pill pill--outline solo-show__link" href={link.href} target="_blank" rel="noopener">
      {link.text}
      <Icon name="external" />
      <span class="visually-hidden"> ({projectsIntro.newTabHint})</span>
    </a>
  ))
}

<style>
  .solo-show__link {
    gap: 10px;
    padding: 0 16px;
  }
</style>
