---
import { contact, isTodo } from '../lib/content';
import { inline } from '../lib/inline';
import Star from './Star.astro';
import Todo from './Todo.astro';
---

<footer class="footer">
  <div class="column footer__inner">
    <Star size={11} />
    {isTodo(contact.footer) ? <Todo text={contact.footer.todo} /> : <p set:html={inline(contact.footer)} />}
  </div>
</footer>

<style>
  .footer {
    border-top: var(--line);
  }

  .footer__inner {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding-top: var(--space-5);
    padding-bottom: var(--space-6);
  }

  .footer p {
    margin: 0;
    font-size: 12.5px;
    font-weight: 500;
    font-stretch: 85%;
  }
</style>
