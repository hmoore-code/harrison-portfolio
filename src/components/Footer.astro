---
// The end of the page, on white below the yellow band: the 6 project stars and "Check out my
// projects", then Back to top, then the footer line.
import { contact, projectsIntro } from '../lib/content';
import Icon from './Icon.astro';
import ProjectStars from './ProjectStars.astro';
import SiteCredit from './SiteCredit.astro';
---

<div class="page-end">
  <div class="column page-end__top">
    <ProjectStars />
    <a class="pill pill--outline page-end__projects" href="#projects">
      {projectsIntro.checkOutProjectsButton}
      <Icon name="arrow" />
    </a>
    <a class="pill pill--outline page-end__back" href="#top">
      <Icon name="up" />
      {contact.backToTop}
    </a>
  </div>
  <footer class="footer">
    <div class="column footer__inner">
      <SiteCredit />
    </div>
  </footer>
</div>

<style>
  .page-end {
    border-top: var(--line);
    background: var(--white);
  }

  .page-end__top {
    display: flex;
    flex-direction: column;
    gap: 22px;
    padding-top: 40px;
  }

  .page-end__top .pill {
    gap: 10px;
    min-height: 52px;
  }

  .page-end__back {
    margin-top: calc(32px - 22px);
  }

  .footer {
    margin-top: 40px;
    border-top: var(--line);
  }

  .footer__inner {
    padding-top: 32px;
    padding-bottom: 48px;
  }
</style>
