---
// The pop-up shell: a sheet sliding up on phones, a centred panel on wider screens.
// dialogs.ts opens and closes it. `parent` names the pop-up it opens from, so closing returns there.
import FilterIcon from './FilterIcon.astro';
import Icon from './Icon.astro';

interface Props {
  id: string;
  labelledby: string;
  label: string;
  // A project pop-up passes its filter so the label gets the filter's icon.
  filterId?: string;
  parent?: string;
}

const { id, labelledby, label, filterId, parent } = Astro.props;
---

<dialog class="sheet" id={id} aria-labelledby={labelledby} data-dialog data-parent={parent}>
  <div class="sheet__bar">
    <p class="label sheet__label">
      {filterId && <FilterIcon filterId={filterId} />}
      {label}
    </p>
    <button class="sheet__close" type="button" data-close-dialog aria-label="Close">
      <Icon name="close" />
    </button>
  </div>
  <div class="sheet__body">
    <slot />
  </div>
</dialog>

<style>
  .sheet__label {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .sheet {
    position: fixed;
    inset: var(--space-6) 0 0;
    width: 100%;
    max-width: var(--column);
    height: auto;
    max-height: none;
    margin: 0 auto;
    padding: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    border: 0;
    border-top: var(--line);
    border-radius: var(--radius-sheet) var(--radius-sheet) 0 0;
    background: var(--paper);
    color: var(--ink);
  }

  .sheet[open] {
    animation: sheet-up 0.35s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .sheet::backdrop {
    background: repeating-linear-gradient(135deg, var(--ink) 0 1.5px, var(--paper) 1.5px 7px);
    opacity: 0.9;
  }

  @media (min-width: 760px) {
    .sheet {
      inset: var(--space-7) 0 0;
      border: var(--line);
      border-bottom: 0;
    }

    .sheet::backdrop {
      background: rgb(17 17 17 / 60%);
      opacity: 1;
    }
  }

  @keyframes sheet-up {
    from {
      transform: translateY(100%);
    }
  }

  .sheet__bar {
    position: sticky;
    top: 0;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding: var(--space-3) var(--gutter) var(--space-2);
    background: var(--paper);
  }

  .sheet__close {
    display: flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border: var(--line);
    border-radius: 50%;
    background: var(--paper);
  }

  .sheet__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    padding: var(--space-2) var(--gutter) 56px;
  }

  .sheet__body :global(.sheet__title) {
    margin: 0;
    font-size: var(--size-popup-title);
    font-weight: 800;
    font-stretch: 62%;
    line-height: 0.86;
  }
</style>
