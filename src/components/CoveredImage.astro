---
// A project photo under its filter's pattern. covers.ts slides the cover off as it scrolls into view.
import { isTodo, type FileRef, type Todo, type Filter } from '../lib/content';
import { findImage } from '../lib/assets';
import Photo from './Photo.astro';

interface Props {
  image: FileRef | Todo;
  alt: string;
  cover: Filter['cover'];
  class?: string;
}

const { image, alt, cover, class: className } = Astro.props;
const hasPhoto = !isTodo(image) && Boolean(findImage(image));
---

<div class:list={['covered', className]} data-cover>
  <Photo class="covered__photo" image={image} alt={alt} />
  {hasPhoto && <div class:list={['covered__sleeve', `covered__sleeve--${cover}`]} aria-hidden="true" />}
</div>

<style>
  .covered {
    --progress: 1;
    position: relative;
    overflow: hidden;
  }

  :global(.js) .covered {
    --progress: 0;
  }

  .covered :global(.covered__photo) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(calc(1 - var(--progress)));
  }

  .covered :global(.photo-missing) {
    height: 100%;
    border-radius: 0;
    border: 0;
    outline: 2px dashed var(--ink);
    outline-offset: -10px;
  }

  .covered__sleeve {
    position: absolute;
    inset: 0;
    border-left: var(--line);
    background-color: rgb(250 250 247 / 45%);
    background-position: center;
    background-size: cover;
    background-repeat: no-repeat;
    transform: translateX(calc(var(--progress) * 92%));
    will-change: transform;
  }

  .covered__sleeve--wavy {
    background-image: url('../../assets/svg/cover-wavy.svg');
  }

  .covered__sleeve--straight {
    background-image: url('../../assets/svg/cover-straight.svg');
  }

  .covered__sleeve--contour {
    background-image: url('../../assets/svg/cover-contour.svg');
  }

  @media (prefers-reduced-motion: reduce) {
    .covered,
    :global(.js) .covered {
      --progress: 1;
    }

    .covered__sleeve {
      display: none;
    }
  }
</style>

<script>
  import { watchCovers } from '../scripts/covers';
  watchCovers();
</script>
