---
// Simple 16px line icons, 1.5px stroke.
interface Props {
  name: 'close' | 'pdf' | 'link' | 'arrow' | 'share' | 'mail' | 'external' | 'document' | 'up';
  class?: string;
}
const { name, class: className } = Astro.props;
const paths = {
  close: 'M3 3l10 10M13 3L3 13',
  pdf: 'M3.5 1.5h6l3 3v10h-9z M9.5 1.5v3h3',
  link: 'M7 2.5H2.5v11h11V9 M9.5 2.5h4v4 M13.5 2.5L7 9',
  arrow: 'M2.5 8h11 M9 3.5L13.5 8L9 12.5',
  share: 'M8 1.5v9 M4.5 5L8 1.5L11.5 5 M3.5 8v6.5h9V8',
  mail: 'M1.5 3.5h13v9h-13z M1.5 3.5L8 9l6.5-5.5',
  document: 'M3.5 1.5h6l3 3v10h-9z M9.5 1.5v3h3 M5.5 8h5 M5.5 10.5h5 M5.5 13h3',
  up: 'M8 14V3 M3.5 7.5L8 3l4.5 4.5',
  // Opens in a new tab: a box with an arrow coming out of it.
  external: 'M9 2 H14 V7 M14 2 L7.5 8.5 M12 10 V13 A1 1 0 0 1 11 14 H3 A1 1 0 0 1 2 13 V5 A1 1 0 0 1 3 4 H6',
};
---

<svg class={className} width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">
  <path
    d={paths[name]}
    fill="none"
    stroke="currentColor"
    stroke-width={name === 'close' || name === 'external' ? 2 : 1.5}
    stroke-linecap="round"
    stroke-linejoin="round"></path>
</svg>
