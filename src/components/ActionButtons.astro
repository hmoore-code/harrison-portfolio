---
// CV, Share and Contact in one row, sharing it equally; Contact is the site's only solid button.
// Shown after the career highlights. Words come from "## Top of page".
import { hero, meta, topBar } from '../lib/content';
import Icon from './Icon.astro';

interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<div class:list={['actions', className]}>
  <a class="pill pill--outline" href="#my-cv" data-open-dialog="my-cv">
    <Icon name="document" />
    {hero.cvLink}
  </a>
  <button
    class="pill pill--outline"
    type="button"
    data-share
    data-share-title={meta.pageTitle}
    data-share-confirmation={topBar.shareConfirmation}
  >
    <Icon name="share" />
    {hero.mainButton}
  </button>
  <a class="pill pill--solid" href={`mailto:${hero.email}`}>
    <Icon name="mail" />
    {hero.emailButton}
  </a>
</div>

<style>
  /* Sized so all 3 labels stay on one line even at 320px wide. */
  .actions {
    display: flex;
    gap: 8px;
  }

  .actions .pill {
    flex: 1 1 0;
    gap: 6px;
    min-width: 0;
    min-height: 48px;
    padding: 0 8px;
    font-size: 15px;
    white-space: nowrap;
  }

  .actions .pill :global(svg) {
    flex: none;
    width: 14px;
    height: 14px;
  }
</style>
