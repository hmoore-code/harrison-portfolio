---
// The CV pop-up. For now it shows only the "Message" from the CV section of copy.md.
import { cv } from '../lib/content';
import Sheet from './Sheet.astro';
---

<Sheet id="my-cv" labelledby="cv-message" compact>
  <p id="cv-message" class="cv__message">{cv.message}</p>
</Sheet>

<style>
  .cv__message {
    margin: 0;
    font-size: var(--size-body);
    line-height: 1.55;
  }
</style>
