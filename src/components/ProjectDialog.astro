---
// One project's case study, opened from its card as a sheet (phone) or centred panel (desktop).
// dialogs.ts handles opening, closing, the URL hash and the back button.
import { getImage } from 'astro:assets';
import { graphicIn, hero, imageIn, isTodo, projectsIntro, topBar, type Project } from '../lib/content';
import { basename } from '../lib/content';
import { findImage, findSvg, findVideo, isVideo } from '../lib/assets';
import { sortEvidence } from '../lib/evidence';
import { resolveTarget } from '../lib/links';
import { inline } from '../lib/inline';
import EvidenceGallery from './EvidenceGallery.astro';
import WorkerFeedbackClubDetails from './more-details/WorkerFeedbackClub.astro';
import TemprDetails from './more-details/Tempr.astro';
import WritersPromptsDetails from './more-details/WritersPrompts.astro';
import WorkshopDetails from './more-details/Workshop.astro';
import SteelCoreDetails from './more-details/SteelCore.astro';
import SoloShowDetails from './more-details/SoloShow.astro';
import NvcGraphic from './graphics/NvcGraphic.astro';
import SixWordStories from './graphics/SixWordStories.astro';
import Icon from './Icon.astro';
import Photo from './Photo.astro';
import Sheet from './Sheet.astro';
import Todo from './Todo.astro';

interface Props {
  project: Project;
}

const { project } = Astro.props;
// Projects whose "More details about this project" has been designed on its own. The others still
// show their pictures, quotes and links from copy.md.
const MoreDetails = {
  'worker-feedback-club': WorkerFeedbackClubDetails,
  tempr: TemprDetails,
  'clever-constraints-for-writers': WritersPromptsDetails,
  'full-cycle-writing-workshop': WorkshopDetails,
  'the-steel-core': SteelCoreDetails,
  'solo-show': SoloShowDetails,
}[project.slug];
// Graphics built in code, placed in the case study with "[NVC graphic goes here]".
const graphics = { 'nvc graphic': NvcGraphic, '6-word stories': SixWordStories };
function graphicFor(name: string, parts: { heading: string }[]) {
  const Graphic = graphics[name.toLowerCase() as keyof typeof graphics];
  const words = parts.find((part) => part.heading.toLowerCase() === name.toLowerCase());
  if (!Graphic || !words)
    throw new Error(`copy.md: "${project.name}" has "[${name} goes here]" but no "#### ${name}" under that heading, or no such graphic`);
  return { Graphic, words };
}
// These pop-up images are wide, so they show at 16:9 instead of the usual 236px crop.
const wideLead = [
  'tempr',
  'clever-constraints-for-writers',
  'full-cycle-writing-workshop',
  'the-steel-core',
  'solo-show',
].includes(project.slug);
// A project's logo (Logo field) shows in the Organisation square instead of the name; screen readers still hear the name.
const logoSvg = project.logo && findSvg(project.logo);
const titleId = `${project.slug}-title`;
const evidence = sortEvidence(project);
const facts = [
  { label: 'Organisation', value: project.organisation },
  { label: 'Year', value: project.year },
  { label: 'Role', value: project.role },
];

// A video's still is the image named "<video name>-poster".
async function videoFor(ref: { file: string }, caption: string) {
  const still = findImage({ file: basename(ref.file).replace(/\.[a-z0-9]+$/i, '-poster.jpg') });
  return {
    caption,
    src: findVideo(ref),
    poster: still ? (await getImage({ src: still, width: 1280, format: 'webp' })).src : undefined,
  };
}
const videos = await Promise.all(evidence.videos.map(({ ref, caption }) => videoFor(ref, caption)));
// A video in the case study, written like a picture: ![](film.mp4 "Caption").
const storyVideos = new Map(
  await Promise.all(
    project.story
      .flatMap((part) => part.blocks)
      .flatMap((block) => ('paragraph' in block ? [imageIn(block.paragraph)] : []))
      .filter((picture) => picture && isVideo(picture.image))
      .map(async (picture) => [picture!.image.file, await videoFor(picture!.image, picture!.caption ?? '')] as const),
  ),
);

const extras = project.extras.map((extra) => ({
  ...extra,
  resolved: extra.link ? resolveTarget(extra.link, project.slug) : null,
}));
---

<Sheet
  id={project.slug}
  labelledby={titleId}
  label={project.filter.label}
  filterId={project.filter.id}
  cover={project.filter.cover}
>
  <header class="sheet__intro">
    <h2 id={titleId} class="sheet__title">{project.title}</h2>
  </header>

  <dl class="facts">
    {
      facts.map((fact, i) => (
        <div class="facts__square">
          <dt>{fact.label}</dt>
          {i === 0 && project.logo ? (
            <dd class="facts__logo">
              {logoSvg ? (
                <img src={logoSvg} alt="" />
              ) : (
                <Photo image={project.logo} alt="" widths={[200, 400]} sizes="88px" />
              )}
              <span class="visually-hidden">{fact.value}</span>
            </dd>
          ) : (
            <dd>{fact.value}</dd>
          )}
        </div>
      ))
    }
  </dl>

  <Photo class:list={['sheet__lead', wideLead && 'sheet__lead--wide']} image={project.popupImage} alt={project.popupImageAlt} sizes="(min-width: 760px) 680px, 100vw" />

  {
    project.story.map((part) => (
      <section class="story">
        <h3 class="subheading">{part.heading}</h3>
        {part.blocks.map((block) => {
          if ('list' in block)
            return (
              <ul class="story__list">
                {block.list.map((item) => (
                  <li set:html={inline(item)} />
                ))}
              </ul>
            );
          const p = block.paragraph;
          const graphic = graphicIn(p);
          if (graphic) {
            const { Graphic, words } = graphicFor(graphic, part.parts);
            return <Graphic node={words} />;
          }
          const picture = imageIn(p);
          const video = picture && storyVideos.get(picture.image.file);
          if (video)
            return (
              <figure class="video story__video">
                {video.src ? (
                  <video controls playsinline preload="none" poster={video.poster} src={video.src} />
                ) : (
                  <Todo text={`Video needed: ${picture.image.file}`} block />
                )}
                <figcaption>{video.caption}</figcaption>
              </figure>
            );
          if (picture?.caption)
            return (
              <figure class="story__figure">
                <Photo image={picture.image} alt={picture.alt} sizes="(min-width: 760px) 640px, 100vw" />
                <figcaption>{picture.caption}</figcaption>
              </figure>
            );
          return picture ? (
            <Photo
              class:list={[
                'story__image',
                picture.shape === '16:9' && 'story__image--wide',
                picture.shape === 'whole' && 'story__image--whole',
              ]}
              image={picture.image}
              alt={picture.alt}
              sizes="(min-width: 760px) 640px, 100vw"
            />
          ) : (
            <p set:html={inline(p)} />
          );
        })}
      </section>
    ))
  }

  <figure class="pull-quote">
    <blockquote>
      “{
        // Words joined by slashes ("teacher/coach/enthusiast") may wrap after each slash.
        project.pullQuote.quote
          .replace(/^["“]|["”]$/g, '')
          .split('/')
          .map((part, i) => (i ? [<>/<wbr /></>, part] : part))
      }”
    </blockquote>
    <figcaption>{project.pullQuote.credit}</figcaption>
  </figure>

  <section class="skills-box">
    <h3 class="subheading">{project.skillsBox.heading}</h3>
    {project.skillsBox.paragraphs.map((p) => <p set:html={inline(p)} />)}
    {
      project.skillsBox.bullets.length > 0 && (
        <ul role="list">
          {project.skillsBox.bullets.map((item) => (
            <li>
              <span set:html={inline(item)} />
            </li>
          ))}
        </ul>
      )
    }
    <p class="skills-box__closing" set:html={inline(projectsIntro.skillsBoxClosingLine)} />
    <div class="skills-box__actions">
      <button
        class="pill pill--solid"
        type="button"
        data-share
        data-share-hash={`#${project.slug}`}
        data-share-title={project.title}
        data-share-confirmation={topBar.shareConfirmation}
      >
        <Icon name="share" />
        {projectsIntro.shareProjectButton}
      </button>
      <a class="pill pill--outline" href={`mailto:${hero.email}`}>
        <Icon name="mail" />
        {projectsIntro.getInTouchButton}
      </a>
    </div>
  </section>

  <section class="evidence" aria-labelledby={`${project.slug}-evidence`}>
    <h3 id={`${project.slug}-evidence`} class="evidence__heading">{project.headings.moreDetails}</h3>

    {MoreDetails && <MoreDetails project={project} />}

    {
      !MoreDetails && evidence.gallery.length > 0 && (
        <EvidenceGallery items={evidence.gallery} cover={project.filter.cover} hint={projectsIntro.galleryHint} />
      )
    }

    {
      !MoreDetails &&
      videos.map((video) => (
        <figure class="video">
          {video.src ? (
            <video controls playsinline preload="none" poster={video.poster} src={video.src} />
          ) : (
            <Todo text={`Video needed: ${video.caption}`} block />
          )}
          <figcaption>{video.caption}</figcaption>
        </figure>
      ))
    }

    {
      !MoreDetails &&
      evidence.quotes.map((set) => (
        <div class="quotes">
          <h4 class="label">{set.label}</h4>
          {set.quotes.map((q) => (
            <figure class="quotes__item">
              <blockquote>“{q.quote}”</blockquote>
              <figcaption>{q.name}</figcaption>
            </figure>
          ))}
        </div>
      ))
    }

    {
      !MoreDetails &&
      (evidence.links.length > 0 || evidence.todos.length > 0) && (
        <ul class="links">
          {evidence.links.map((link) => (
            <li>
              <a
                class="link-pill"
                href={link.href}
                data-open-dialog={link.dialog}
                target={link.type === 'popup' ? undefined : '_blank'}
                rel={link.type === 'popup' ? undefined : 'noopener'}
              >
                <span>{link.label}</span>
                <span class="link-pill__type">
                  <Icon name={link.type === 'pdf' ? 'pdf' : link.type === 'popup' ? 'arrow' : 'link'} />
                  {link.type === 'pdf' ? 'PDF' : link.type === 'popup' ? 'Case study' : 'Link'}
                  {link.type !== 'popup' && <span class="visually-hidden">, {projectsIntro.newTabHint}</span>}
                </span>
              </a>
            </li>
          ))}
          {evidence.todos.map((todo) => (
            <li>
              <Todo text={`${todo.label}: ${todo.text}`} block />
            </li>
          ))}
        </ul>
      )
    }
  </section>

  {
    (extras.length > 0 || project.tryItYourself) && (
      <div class="extras">
        {project.tryItYourself && (
          <a class="pill pill--solid" href={`#${project.slug}-try`} data-open-dialog={`${project.slug}-try`}>
            {project.tryItYourself.button}
          </a>
        )}
        {extras.map((extra) =>
          extra.resolved ? (
            <a
              class="pill pill--solid"
              href={extra.resolved.href}
              target={extra.resolved.external ? '_blank' : undefined}
              rel={extra.resolved.external ? 'noopener' : undefined}
            >
              {extra.button}
              {extra.resolved.external && <span class="visually-hidden"> ({projectsIntro.newTabHint})</span>}
            </a>
          ) : (
            <Todo text={`${extra.button}: ${extra.text && isTodo(extra.text) ? extra.text.todo : 'TO DO: add a link'}`} block />
          ),
        )}
      </div>
    )
  }

  {
    project.exhibitionList && (
      <section class="story">
        <h3 class="subheading">{project.exhibitionList.heading}</h3>
        <p>{project.exhibitionList.intro}</p>
        <ul class="exhibitions">
          {project.exhibitionList.items.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </section>
    )
  }
</Sheet>

<style>
  .sheet__intro {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }


  /* Organisation, year and role in 3 squares drawn with wavy lines. */
  .facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 0;
    padding: 5px;
    background:
      url('../../assets/svg/rule-wavy.svg') top / 100% 10px no-repeat,
      url('../../assets/svg/rule-wavy.svg') bottom / 100% 10px no-repeat,
      url('../../assets/svg/wave-v.svg') left / 10px 100% no-repeat,
      url('../../assets/svg/wave-v.svg') right / 10px 100% no-repeat,
      url('../../assets/svg/wave-v.svg') 33.6% 0 / 10px 100% no-repeat,
      url('../../assets/svg/wave-v.svg') 66.4% 0 / 10px 100% no-repeat;
  }

  .facts__square {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    /* At least square; grows if a long organisation name needs more room. */
    aspect-ratio: 1;
    padding: 10px 14px;
  }

  /* Square on phones; on wide screens squares would be needlessly tall. */
  @media (min-width: 760px) {
    .facts__square {
      aspect-ratio: auto;
      min-height: 120px;
    }
  }

  .facts dt {
    color: var(--grey);
    font-size: 11px;
    font-weight: 500;
  }

  /* The logo, centred in the rest of the square, at most 88px either way. */
  .facts .facts__logo {
    display: flex;
    flex: 1;
    align-items: center;
    justify-content: center;
  }

  .facts__logo :global(img) {
    width: 100%;
    max-width: 88px;
    height: auto;
    max-height: 88px;
    object-fit: contain;
  }

  .facts dd {
    margin: 0;
    font-size: 12.5px;
    font-weight: 500;
    font-stretch: 85%;
    line-height: 1.25;
    overflow-wrap: anywhere;
  }

  /* Lead photo: full colour, no cover (covers are only on cards and evidence thumbnails). */
  :global(.sheet__lead) {
    width: 100%;
    height: 236px;
    object-fit: cover;
    border: var(--line);
    border-radius: var(--radius-inner);
  }

  :global(.sheet__lead.sheet__lead--wide) {
    height: auto;
    aspect-ratio: 16 / 9;
  }

  /* "The skills I could bring to your team": a box drawn with wavy lines, like the facts squares. */
  .skills-box {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: calc(5px + var(--space-5)) calc(5px + var(--space-5));
    background:
      url('../../assets/svg/rule-wavy.svg') top / 100% 10px no-repeat,
      url('../../assets/svg/rule-wavy.svg') bottom / 100% 10px no-repeat,
      url('../../assets/svg/wave-v.svg') left / 10px 100% no-repeat,
      url('../../assets/svg/wave-v.svg') right / 10px 100% no-repeat;
  }

  .skills-box p,
  .skills-box ul {
    margin: 0;
    font-size: 17px;
    line-height: 1.55;
  }

  /* role="list" keeps it a list for VoiceOver, which drops list-style: none lists. */
  .skills-box ul {
    display: grid;
    gap: var(--space-1);
    padding: 0;
    list-style: none;
  }

  /* The star as the bullet: 12px, centred on the first line, 10px before the text. */
  .skills-box li {
    display: grid;
    grid-template-columns: 12px 1fr;
    column-gap: 10px;
  }

  .skills-box li::before {
    content: '';
    width: 12px;
    height: 12px;
    margin-top: calc((1.55em - 12px) / 2);
    background: url('../../assets/svg/star.svg') center / contain no-repeat;
  }

  /* 14px above in all (the box's gap plus this margin). */
  .skills-box .skills-box__closing {
    margin-top: calc(14px - var(--space-2));
  }

  /* Share this project and Get in touch, stacked; 18px above them in all (the box's gap plus this margin). */
  .skills-box__actions {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-top: calc(18px - var(--space-2));
  }

  .skills-box__actions .pill {
    min-height: 52px;
    font-size: 17px;
    font-weight: 700;
  }

  /* A picture inside the case study text: square, cropped to fill. */
  .story :global(.story__image) {
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    border: var(--line);
    border-radius: var(--radius-inner);
  }

  /* A picture with a caption: shown whole, not cropped, caption below in small grey. */
  /* A whole 16:9 picture, not cropped to a square. */
  .story :global(.story__image.story__image--wide) {
    aspect-ratio: 16 / 9;
    margin: 8px 0;
  }

  /* A whole picture in its own shape, not cropped, with no border. */
  .story :global(.story__image.story__image--whole) {
    aspect-ratio: auto;
    margin: 8px 0;
    border: 0;
  }

  .story__video {
    margin: 8px 0;
  }

  .story__list {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin: 0;
    padding-left: 22px;
    font-size: 17px;
    line-height: 1.55;
  }

  .story__figure {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin: 8px 0;
  }

  .story__figure :global(img) {
    width: 100%;
    height: auto;
    border: var(--line);
    border-radius: var(--radius-inner);
  }

  .story__figure figcaption {
    color: var(--grey);
    font-size: 12px;
    line-height: 1.4;
  }

  .pull-quote {
    margin: 0;
  }

  .pull-quote blockquote {
    margin: 0;
    /* A word too long for the screen wraps rather than pushing the pop-up wider. */
    overflow-wrap: break-word;
    font-family: var(--font-quote);
    font-size: var(--size-card-title);
    font-style: italic;
    font-weight: 400;
    line-height: 1.05;
  }

  .pull-quote figcaption {
    margin-top: 10px;
    font-size: 15px;
    font-weight: 600;
  }

  /* "More details about this project". Sizes follow design/12 exactly. */
  .evidence {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .evidence__heading {
    margin: 0;
    font-size: 36px;
    font-weight: 800;
    font-stretch: 62%;
    line-height: 0.95;
  }

  .video {
    margin: 0;
    overflow: hidden;
    border: var(--line);
    border-radius: var(--radius-inner);
    background: var(--white);
  }

  .video video {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    background: var(--ink);
  }

  .video figcaption {
    padding: 10px 14px;
    border-top: var(--line);
    font-size: 15px;
  }

  .quotes {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .quotes__item {
    margin: 0;
    padding: var(--space-4);
    border: var(--line);
    border-radius: var(--radius-inner);
    background: var(--white);
  }

  .quotes__item blockquote {
    margin: 0;
    font-family: var(--font-quote);
    font-size: 21px;
    font-style: italic;
    font-weight: 400;
    line-height: 1.35;
  }

  .quotes__item figcaption {
    margin-top: var(--space-2);
    font-size: 13px;
    font-weight: 600;
  }

  .exhibitions {
    margin: 0;
    padding-left: 1.2em;
    font-size: 15px;
    line-height: 1.5;
  }
</style>
