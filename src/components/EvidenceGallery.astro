---
// A large frame plus square thumbnails under the project's cover pattern.
// Tapping a thumbnail lifts its cover, shows it in colour and puts it in the frame.
import type { FileRef, Filter } from '../lib/content';
import Photo from './Photo.astro';

interface Props {
  items: { ref: FileRef; caption: string }[];
  cover: Filter['cover'];
  hint: string;
}

const { items, cover, hint } = Astro.props;

// Number pictures that share a caption: "Product screens (2 of 6)".
const totals = new Map<string, number>();
items.forEach(({ caption }) => totals.set(caption, (totals.get(caption) ?? 0) + 1));
const seen = new Map<string, number>();
const slides = items.map(({ ref, caption }) => {
  const n = (seen.get(caption) ?? 0) + 1;
  seen.set(caption, n);
  const total = totals.get(caption)!;
  return { ref, caption: total > 1 ? `${caption} (${n} of ${total})` : caption };
});
---

<div class="gallery" data-gallery>
  <p class="gallery__hint">{hint}</p>
  <div class="gallery__frame">
    {
      slides.map((slide, i) => (
        <figure class="gallery__slide" data-slide={i} hidden={i !== 0}>
          <div class="gallery__image">
            <Photo image={slide.ref} alt={slide.caption} sizes="(min-width: 760px) 680px, 100vw" />
          </div>
          <figcaption>{slide.caption}</figcaption>
        </figure>
      ))
    }
  </div>
  {
    slides.length > 1 && (
      <div class="gallery__thumbs" role="group" aria-label="Pictures">
        {slides.map((slide, i) => (
          <button
            class="thumb"
            type="button"
            data-thumb={i}
            aria-pressed={i === 0 ? 'true' : 'false'}
            aria-label={`Show picture ${i + 1} of ${slides.length}: ${slide.caption}`}
          >
            <Photo class="thumb__photo" image={slide.ref} alt="" widths={[200, 400]} sizes="160px" />
            <span class:list={['thumb__cover', `thumb__cover--${cover}`]} aria-hidden="true" />
          </button>
        ))}
      </div>
    )
  }
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((gallery) => {
    const slides = gallery.querySelectorAll<HTMLElement>('[data-slide]');
    const thumbs = gallery.querySelectorAll<HTMLButtonElement>('[data-thumb]');
    thumbs.forEach((thumb) =>
      thumb.addEventListener('click', () => {
        const chosen = thumb.dataset.thumb;
        thumbs.forEach((t) => t.setAttribute('aria-pressed', String(t === thumb)));
        slides.forEach((s) => (s.hidden = s.dataset.slide !== chosen));
      }),
    );
  });
</script>

<style>
  .gallery {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .gallery__hint {
    margin: 0;
    font-size: 15px;
  }

  .gallery__frame {
    overflow: hidden;
    border: var(--line);
    border-radius: var(--radius-inner);
    background: var(--white);
  }

  .gallery__slide {
    margin: 0;
  }

  .gallery__slide[hidden] {
    display: none;
  }

  .gallery__image {
    height: 260px;
    padding: var(--space-2);
  }

  .gallery__image :global(img),
  .gallery__image :global(.photo-missing) {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .gallery__slide figcaption {
    padding: 10px 14px;
    border-top: var(--line);
    font-size: 15px;
    line-height: 1.4;
  }

  .gallery__thumbs {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-2);
  }

  .thumb {
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
    padding: 0;
    border: var(--line);
    border-radius: var(--radius-thumb);
    background: var(--white);
  }

  .thumb[aria-pressed='true'] {
    border-width: 3px;
  }

  .thumb :global(.thumb__photo) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1);
    transition: filter 0.3s;
  }

  .thumb[aria-pressed='true'] :global(.thumb__photo) {
    filter: none;
  }

  .thumb__cover {
    position: absolute;
    inset: 0;
    background-color: rgb(250 250 247 / 45%);
    background-position: center;
    background-size: cover;
    transition: transform 0.4s;
  }

  .thumb[aria-pressed='true'] .thumb__cover {
    transform: translateY(100%);
  }

  .thumb__cover--wavy {
    background-image: url('../../assets/svg/cover-wavy.svg');
  }

  .thumb__cover--straight {
    background-image: url('../../assets/svg/cover-straight.svg');
  }

  .thumb__cover--contour {
    background-image: url('../../assets/svg/cover-contour.svg');
  }
</style>
