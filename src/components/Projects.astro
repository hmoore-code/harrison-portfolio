---
import { filters, projects, projectsIntro } from '../lib/content';
import FilterIcon from './FilterIcon.astro';
import ProjectCard from './ProjectCard.astro';
import Star from './Star.astro';

// Each chip shows how many projects in copy.md sit under that filter.
const buttons = [{ id: 'all', label: projectsIntro.allFilter }, ...filters].map((filter) => ({
  ...filter,
  count: filter.id === 'all' ? projects.length : projects.filter((p) => p.filter.id === filter.id).length,
}));
---

<section class="projects column" id="projects" aria-labelledby="projects-heading">
  <div class="projects__intro">
    <h2 id="projects-heading" class="section-heading">{projectsIntro.heading}</h2>
    <p>{projectsIntro.intro}</p>
  </div>

  <div class="filters-wrap">
    <p class="filters__label" id="filters-label">{projectsIntro.filterLabel}</p>
    <div class="filters" role="group" aria-labelledby="filters-label" data-filters>
      {
        buttons.map((filter) => (
          <button class="filter" type="button" data-filter={filter.id} aria-pressed={filter.id === 'all' ? 'true' : 'false'}>
            {filter.id === 'all' ? <Star size={16} class="filter__star" /> : <FilterIcon filterId={filter.id} />}
            <span>{filter.label}</span>{' '}
            <span class="filter__count">{filter.count}</span>
          </button>
        ))
      }
    </div>
  </div>

  <div class="projects__list">
    {projects.map((project, index) => <ProjectCard project={project} index={index} />)}
  </div>
</section>

<script>
  const group = document.querySelector<HTMLElement>('[data-filters]');
  const buttons = [...(group?.querySelectorAll<HTMLButtonElement>('button[data-filter]') ?? [])];
  const cards = [...document.querySelectorAll<HTMLElement>('.projects__list [data-filter]')];
  const ids = buttons.map((b) => b.dataset.filter);

  function apply(id: string, updateUrl: boolean) {
    if (!ids.includes(id)) id = 'all';
    buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.filter === id)));
    cards.forEach((card) => (card.hidden = id !== 'all' && card.dataset.filter !== id));
    if (updateUrl) {
      const url = new URL(window.location.href);
      if (id === 'all') url.searchParams.delete('filter');
      else url.searchParams.set('filter', id);
      history.replaceState(history.state, '', url);
    }
    document.dispatchEvent(new Event('covers:refresh'));
  }

  buttons.forEach((b) => b.addEventListener('click', () => apply(b.dataset.filter ?? 'all', true)));
  apply(new URLSearchParams(window.location.search).get('filter') ?? 'all', false);
</script>

<style>
  .projects {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    /* No star divider above or below any more, so the section brings its own room (design/18). */
    padding-top: 48px;
    padding-bottom: 50px;
  }

  .projects__intro {
    display: flex;
    flex-direction: column;
    gap: calc(10px * var(--spacing-scale));
  }

  .projects__intro p {
    margin: 0;
    font-size: 17px;
    font-weight: 500;
    line-height: 1.45;
  }

  .filters-wrap {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .filters__label {
    margin: 0;
    color: var(--grey);
    font-size: 13px;
    font-weight: 600;
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  /* Square-cornered chips, so they read as filters rather than buttons. */
  .filter {
    display: flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 0 12px;
    border: var(--line);
    border-radius: 8px;
    background: var(--white);
    color: var(--ink);
    font-size: 14px;
    font-weight: 600;
    line-height: 1.2;
    text-align: left;
  }

  .filter :global(.filter-icon) {
    height: 18px;
  }

  .filter__count {
    color: var(--grey);
    font-size: 12px;
    font-weight: 600;
  }

  .filter[aria-pressed='true'] {
    background: var(--ink);
    color: var(--paper);
  }

  .filter[aria-pressed='true'] :global(.filter-icon) {
    filter: invert(1);
  }

  .filter[aria-pressed='true'] .filter__count {
    color: rgb(250 250 247 / 75%);
  }

  .projects__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }
</style>
