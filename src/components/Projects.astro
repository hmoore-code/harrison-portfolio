---
import { projects, projectsIntro } from '../lib/content';
import ProjectCard from './ProjectCard.astro';
---

<section class="projects column" id="projects" aria-labelledby="projects-heading">
  <div class="projects__intro">
    <h2 id="projects-heading" class="section-heading">{projectsIntro.heading}</h2>
    <p>{projectsIntro.intro}</p>
  </div>

  <div class="projects__list">
    {projects.map((project, index) => <ProjectCard project={project} index={index} />)}
  </div>
</section>

<style>
  .projects {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    /* No star divider above or below any more, so the section brings its own room (design/18). */
    padding-top: 48px;
    padding-bottom: 50px;
  }

  .projects__intro {
    display: flex;
    flex-direction: column;
    gap: calc(10px * var(--spacing-scale));
  }

  .projects__intro p {
    margin: 0;
    font-size: 17px;
    font-weight: 500;
    line-height: 1.45;
  }

  .projects__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }
</style>
