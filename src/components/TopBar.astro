---
import { hero, topBar, meta } from '../lib/content';
---

<header class="top-bar">
  <div class="top-bar__inner">
    <a class="top-bar__name" href="#top">
      {topBar.label}
    </a>
    <div class="top-bar__actions">
      <a class="top-bar__action" href="#my-cv" data-open-dialog="my-cv">{topBar.cvButton}</a>
      <button
        class="top-bar__action"
        type="button"
        data-share
        data-share-title={meta.pageTitle}
        data-share-confirmation={topBar.shareConfirmation}
      >
        {topBar.shareButton}
      </button>
      <a class="top-bar__action" href={`mailto:${hero.email}`}>{topBar.emailButton}</a>
    </div>
  </div>
</header>

<script>
  import { showToast } from '../scripts/toast';

  document.querySelectorAll<HTMLButtonElement>('[data-share]').forEach((button) => {
    button.addEventListener('click', async () => {
      // A project's share button adds its pop-up's #link, so the link opens straight to it.
      const url = window.location.href.split('#')[0] + (button.dataset.shareHash ?? '');
      const title = button.dataset.shareTitle ?? document.title;
      if (navigator.share) {
        try {
          await navigator.share({ title, url });
          return;
        } catch (error) {
          if ((error as DOMException).name === 'AbortError') return;
        }
      }
      try {
        await navigator.clipboard.writeText(url);
        showToast(button.dataset.shareConfirmation ?? '');
      } catch {
        window.prompt('', url);
      }
    });
  });
</script>

<style>
  .top-bar {
    position: sticky;
    top: 0;
    z-index: 10;
    height: 48px;
    background: var(--paper);
    border-bottom: var(--line);
  }

  .top-bar__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 100%;
    max-width: var(--column);
    margin: 0 auto;
    padding: 0 var(--gutter);
  }

  /* Name and links all stay on one line, down to 320px wide. */
  .top-bar__name {
    display: flex;
    align-items: center;
    min-width: 0;
    min-height: 44px;
    font-size: var(--size-label);
    font-weight: 600;
    line-height: 1.2;
    text-decoration: none;
    white-space: nowrap;
  }

  .top-bar__actions {
    display: flex;
    flex: none;
  }

  .top-bar__action {
    display: flex;
    align-items: center;
    min-height: 44px;
    padding: 0 10px;
    border: 0;
    background: transparent;
    color: var(--blue);
    font-size: var(--size-label);
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
  }

  .top-bar__action:last-child {
    padding-right: 0;
  }

  /* Very small phones: a touch smaller and tighter so everything still fits on one line. */
  @media (max-width: 359px) {
    .top-bar__inner {
      padding: 0 16px;
    }

    .top-bar__name,
    .top-bar__action {
      font-size: 12px;
    }

    .top-bar__action {
      padding: 0 6px;
    }
  }
</style>
