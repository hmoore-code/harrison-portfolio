---
import { hero, topBar, meta } from '../lib/content';
import Icon from './Icon.astro';
import Star from './Star.astro';
---

<header class="top-bar">
  <div class="top-bar__inner">
    <a class="top-bar__name" href="#top">
      <Star size={11} />
      {topBar.label}
    </a>
    <div class="top-bar__actions">
      <a class="top-bar__action" href={`mailto:${hero.email}`}>
        <Icon name="mail" />
        {topBar.emailButton}
      </a>
      <button
        class="top-bar__action"
        type="button"
        data-share
        data-share-title={meta.pageTitle}
        data-share-confirmation={topBar.shareConfirmation}
      >
        <Icon name="share" />
        {topBar.shareButton}
      </button>
    </div>
  </div>
</header>

<script>
  import { showToast } from '../scripts/toast';

  document.querySelectorAll<HTMLButtonElement>('[data-share]').forEach((button) => {
    button.addEventListener('click', async () => {
      // A project's share button adds its pop-up's #link, so the link opens straight to it.
      const url = window.location.href.split('#')[0] + (button.dataset.shareHash ?? '');
      const title = button.dataset.shareTitle ?? document.title;
      if (navigator.share) {
        try {
          await navigator.share({ title, url });
          return;
        } catch (error) {
          if ((error as DOMException).name === 'AbortError') return;
        }
      }
      try {
        await navigator.clipboard.writeText(url);
        showToast(button.dataset.shareConfirmation ?? '');
      } catch {
        window.prompt('', url);
      }
    });
  });
</script>

<style>
  .top-bar {
    position: sticky;
    top: 0;
    z-index: 10;
    height: 48px;
    background: var(--paper);
    border-bottom: var(--line);
  }

  .top-bar__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 100%;
    max-width: var(--column);
    margin: 0 auto;
    padding: 0 var(--space-2) 0 var(--gutter);
  }

  .top-bar__name {
    display: flex;
    align-items: center;
    gap: 7px;
    min-height: 44px;
    font-size: 13px;
    font-weight: 600;
    line-height: 1.2;
    text-decoration: none;
  }

  /* The star and the icons keep their size; on very small phones the name wraps instead. */
  .top-bar__name :global(svg),
  .top-bar__action :global(svg) {
    flex: none;
  }

  .top-bar__actions {
    display: flex;
    flex: none;
  }


  .top-bar__action {
    display: flex;
    align-items: center;
    gap: 7px;
    min-height: 44px;
    padding: 0 12px;
    border: 0;
    background: transparent;
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
  }

  /* Very small phones: tighter buttons so the name keeps to 2 lines at most. */
  @media (max-width: 359px) {
    .top-bar__inner {
      padding-left: 16px;
    }

    .top-bar__action {
      gap: 5px;
      padding: 0 7px;
    }
  }
</style>
