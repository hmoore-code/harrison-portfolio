---
// "Help me find the right team" (#cv), after the projects: the heading, one paragraph, then the
// CV, Share and Contact buttons.
// Words come from "## Track record".
import { trackRecord } from '../lib/content';
import { inline } from '../lib/inline';
import ActionButtons from './ActionButtons.astro';
---

<section class="record column" id="cv" aria-labelledby="record-heading">
  <div class="record__intro">
    <h2 id="record-heading" class="section-heading">{trackRecord.label}</h2>
    <p set:html={inline(trackRecord.intro)} />
  </div>

  <ActionButtons />
</section>

<style>
  .record {
    display: flex;
    flex-direction: column;
    gap: 27.5px;
    /* No star divider below any more, so the section brings its own room before the testimonials. */
    padding-top: 48px;
    padding-bottom: 64px;
  }

  .record__intro {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .record__intro p {
    margin: 0;
    font-size: var(--size-body);
    line-height: 1.55;
  }
</style>
