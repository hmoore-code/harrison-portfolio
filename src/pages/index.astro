---
import Base from '../layouts/Base.astro';
import TopBar from '../components/TopBar.astro';
import Hero from '../components/Hero.astro';
import StarDivider from '../components/StarDivider.astro';
import Projects from '../components/Projects.astro';
import ProjectDialog from '../components/ProjectDialog.astro';
import { meta, projects } from '../lib/content';
---

<Base title={meta.pageTitle} description={meta.shareDescription}>
  <TopBar />
  <main id="top">
    <Hero />
    <StarDivider />
    <Projects />
  </main>
  {projects.map((project) => <ProjectDialog project={project} />)}
</Base>

<script>
  import '../scripts/dialogs';
</script>
